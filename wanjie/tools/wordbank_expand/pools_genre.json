  "BODY_REACTION_EXPAND": {
    "puzzled": "眉头微蹙，指尖无意识地在膝上敲了两下。",
    "relief": "绷紧的肩线忽然松下来，长长地呼出一口气。",
    "curiosity": "身体不自觉前倾，目光钉在那件东西上。",
    "disgust": "下颚绷紧，喉头轻轻滚动，像要把什么咽回去。",
    "pride": "下巴微抬，胸膛不经意地挺直了半分。",
    "shame": "视线垂下去，指节抠进掌心。",
    "longing": "目光越过人群，落在某个回不来的方向上。",
    "tired": "肩背垮下来，像被抽走了半根骨头。",
    "alert": "整个人瞬间绷成一张弓，呼吸放到了最轻。",
    "amused": "唇角压着一点笑，肩却懒懒地晃了晃。",
    "cold": "瞳孔缩了一下，周身的气场冷了半度。",
    "warm": "眉眼舒展开，连指尖都软了三分。",
    "doubt": "头微微偏开，像在重新打量眼前的人。",
    "trust": "向后靠进椅背，把最脆弱的颈侧露了出来。",
    "panic": "手指骤然攥紧，指节白得发青。",
    "calm": "呼吸平稳得像一面无风的湖，连眨眼都慢了半拍。"
  },
  "CHAPTER_TEMPLATES": [
    "归墟的蓝光照在{place}上，{subj}把今天发生的事在脑子里过了一遍——像过一遍游戏日志。",
    "协议第一章写的是「{modifier}享有万界管辖权」。{subj}把这两条放在一起读了十遍，终于读出了背后的意思。",
    "{subj}给自己定了条规矩：每天睡前必须想清楚一件事——今天做的决定里，有几件是真的出于判断。",
    "归墟里没有时间。{subj}靠墟核的闪烁频率来估算，大概过了三个小时，也可能是三天。",
    "{subj}把{thing}当成了日历。每过一天划一道。墙已经快划满了，他都不敢去数到底代表了多少个循环。",
    "他一度以为自己早就习惯了孤独。直到玩家们到来，他才意识到那种状态不叫习惯，叫还没察觉自己缺了什么。",
    "{subj}发现自己在模仿墟核的语气说话——冷静、精确、不带情绪。他吓了一跳。",
    "归墟的墙很厚，厚到把所有声音都吃掉。{subj}渐渐养成了一个习惯：说话时先在心里过一遍。",
    "他把协议的十六章按重要性排了个序，排完发现最靠前的三条，都不是关于世界的，是关于他的。",
    "{subj}想过一个问题：如果归墟只是个系统，那它为什么要有一个人的位置？",
    "他在归墟的第一年学会了一件事：不要问为什么是我。改成了另一个问题：既然是我，那能做到哪一步。",
    "归墟不评价他。这一点起初让他轻松，后来让他难受。没有评价意味着没有校准。",
    "他把值不值得这四个字从思考里剔除了。做决定的人不能算账，算账的人做不了决定。",
    "{subj}意识到，自己已经很久没有用过回家的这个词了。归墟不是家，地球也不再是。",
    "所谓锚定，说到底是把自己钉在一个位置上，让别的东西可以围着这个位置转。"
  ],
  "CONNECTOR_TEMPLATES": [
    "可是，",
    "然而，",
    "与此同时，",
    "话音未落，",
    "就在这时，",
    "没有人注意到，",
    "更深处，",
    "而那一边，",
    "反过来说，",
    "只不过，",
    "不出所料，",
    "出乎意料的是，",
    "换句话说，",
    "问题是，",
    "关键在于，",
    "说来也怪，",
    "往后看，",
    "再往前，",
    "说到底，",
    "到头来，"
  ],
