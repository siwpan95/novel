  ],
  "foreshadowing": [
    {
      "id": "fs_fragment_memory",
      "content": "碎片记忆在他眼前展开，里面那张脸他看了半天才认出——是年轻的自己，只是眼神比现在干净太多。",
      "planted_chapter": 6,
      "planned_recovery_chapter": 15,
      "status": "recovered",
      "recovery_text": "那张碎片里的脸又浮上来。他终于确认：那是第47次循环开头的林朔，还没被任何真相磨过。",
      "recovered_chapter": 12
    },
    {
      "id": "fs_star_map_flicker",
      "content": "归墟星图亮起十二个光点，其中一个在不安地闪烁，像一盏快要熄灭的灯，又像一盏被人掐住喉咙的灯。",
      "planted_chapter": 12,
      "planned_recovery_chapter": 16,
      "status": "recovered",
      "recovery_text": "星图上那盏闪烁的灯，终于灭了一瞬——对应世界里，第一个碎片刚刚被「祂们」提前取走。",
      "recovered_chapter": 13
    },
    {
      "id": "fs_protocol_appendix",
      "content": "墟核在他掌心投出一份《协议附录》，第三条被涂抹的痕迹比正文更刺眼——他没有急着读，先把它记进了归墟核心。",
      "planted_chapter": 18,
      "planned_recovery_chapter": 26,
      "status": "recovered",
      "recovery_text": "那份被涂抹的《协议附录》第三条，此刻在归墟核心里重新显形：原来那一行写的是——「锚定者可被替换」。",
      "recovered_chapter": 23
    },
    {
      "id": "fs_baiye_trace",
      "content": "数据流的缝隙里藏着一道极淡的痕迹，像有人反复来过又反复抹去——他第一次觉得，自己不是唯一的守望者。",
      "planted_chapter": 24,
      "planned_recovery_chapter": 30,
      "status": "recovered",
      "recovery_text": "那道被反复抹去的痕迹，此刻拼出了一个名字：白夜。原来早在林朔之前，就有人守在这里。",
      "recovered_chapter": 27
    },
    {
      "id": "fs_player_cost",
      "content": "第一个玩家真正降临的代价，是归墟核心悄悄多出了一道裂纹——当时没有人注意到，连墟核都装作没看见。",
      "planted_chapter": 30,
      "planned_recovery_chapter": 36,
      "status": "recovered",
      "recovery_text": "归墟核心那道裂纹又张开了。它从不真正愈合，只是等下一个玩家降临，再咬一口。",
      "recovered_chapter": 33
    },
    {
      "id": "fs_gm_gray_cmd",
      "content": "林朔点开GM面板时，发现自己的权限列表最底下有一行从未见过的灰色指令，标签是乱码。",
      "planted_chapter": 36,
      "planned_recovery_chapter": 41,
      "status": "recovered",
      "recovery_text": "那行灰色指令终于解开了乱码——它只有一个作用：把当前锚定者，重置回第一天的起点。",
      "recovered_chapter": 38
    },
    {
      "id": "fs_void_echo",
      "content": "他听见虚空里有回声，像另一个自己隔着很厚的墙在说话，墙那边的人似乎也卡在某个循环里。",
      "planted_chapter": 42,
      "planned_recovery_chapter": 49,
      "status": "recovered",
      "recovery_text": "虚空的回声又响了一次——这一次他听懂了：那是第47次循环里，前一个林朔留给自己的警告。",
      "recovered_chapter": 46
    },
    {
      "id": "fs_core_breath_sync",
      "content": "归墟核心的呼吸，和一枚尚未回收的碎片能量曲线，慢半拍地同频了一下——像两个本该无关的东西，被同一根线牵着。",
      "planted_chapter": 48,
      "planned_recovery_chapter": 57,
      "status": "recovered",
      "recovery_text": "核心与碎片的同频不再是错觉。它只说明一件事：林朔自己，就是那根牵线的手。",
      "recovered_chapter": 54
    },
    {
      "id": "fs_fail_light",
      "content": "崩塌时归墟蓝光熄了一半，林朔第一次笑得出——终于不用装撑得住。",
      "planted_chapter": 6,
      "planned_recovery_chapter": 8,
      "status": "recovered",
      "recovery_text": "那笑，在重生时被新锚定者看见录像。他懂了：承认撑不住，才是真撑住的开始。",
      "recovered_chapter": 7
    },
    {
      "id": "fs_inciting_125",
      "content": "有个玩家问他要签名。林朔在对方装备上刻了个「朔」字，刻完手抖了一下。",
      "planted_chapter": 6,
      "planned_recovery_chapter": 16,
      "status": "recovered",
      "recovery_text": "那个刻在装备上的「朔」字，在他消失后成了唯一的实证。玩家靠它证明：GM真的存在过。",
      "recovered_chapter": 13
    },
    {
      "id": "fs_frag_122",
      "content": "他第一次带着伤回归墟，伤口三分钟就好了。他盯着完好的皮肤，忽然觉得冷。",
      "planted_chapter": 6,
      "planned_recovery_chapter": 15,
      "status": "recovered",
      "recovery_text": "伤口三分钟愈合的代价，写在源能账目里：每好一次，星图上就有一个光点暗一格。",
      "recovered_chapter": 12
    },
    {
      "id": "fs_map_tree",
      "content": "星图全貌是一棵倒长的树，根在混沌海。林朔把根的位置画了下来，标「勿碰」。",
      "planted_chapter": 6,
      "planned_recovery_chapter": 10,
      "status": "recovered",
      "recovery_text": "那根，在中点后被「祂们」拽了一下。林朔这才懂：万界这棵树，一直被人从土里往外拔。",
      "recovered_chapter": 7
    },
    {
      "id": "fs_al_117",
      "content": "能量归零那秒，归墟没有崩塌，而是停住了。像一口气吸到一半，忘了呼出来。",
      "planted_chapter": 12,
      "planned_recovery_chapter": 18,
      "status": "recovered",
      "recovery_text": "那口没呼出的气，撑到了玩家们回来的那一刻。归墟不是撑住了，是在憋着，等人。",
      "recovered_chapter": 15
    },
    {
      "id": "fs_map_117",
      "content": "星图正中央有一个不发光的黑点。放大到极限，黑点里有极细的一行字。",
      "planted_chapter": 18,
      "planned_recovery_chapter": 23,
      "status": "recovered",
      "recovery_text": "黑点里的那行字终于读清：「此处曾有一个世界，居民自愿删除自己，以换取剩余者的时间。」",
      "recovered_chapter": 20
    },
    {
      "id": "fs_inciting_117",
      "content": "开服那晚他睡了四个小时——两万年来的第一次。醒来时星图多亮了一个光点。",
      "planted_chapter": 24,
      "planned_recovery_chapter": 32,
      "status": "recovered",
      "recovery_text": "那个多出来的光点，是在他睡着时自己亮的。归墟第一次证明：它可以不靠他，撑一会儿。",
      "recovered_chapter": 29
    },
    {
      "id": "fs_baiye_thanks",
      "content": "第二次转折林朔对虚空说「谢谢」，对象是所有倒在前面的林朔。",
      "planted_chapter": 36,
      "planned_recovery_chapter": 45,
      "status": "active",
      "recovery_text": "那声谢，在 epilogue 被回响：前面46人，把失败叠成了他脚下的台阶。"
    }
  ],
